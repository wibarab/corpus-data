                TIME_SLOT_REF1="ts7" TIME_SLOT_REF2="ts8">
                <ANNOTATION_VALUE>hāḏa diriǧ hūla w hāḏa l-il-heyl, l-il-gahwa hāḏa l-gahwa ḥagg il-heyl, hāḏa l-il-gahwa.</ANNOTATION_VALUE>
